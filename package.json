{
  "name": "@qweit-crystal/dsh-doctor",
  "version": "0.5.0",
  "description": "跨引擎 DSH 体检插件：自动发现本机所有 DeepSeek Harness 引擎/实例与 profile，分层体检（端口/装配/ABI/日志），结论带稳定 id 与「无法取证」态，附脱敏案例库与体检历史；设置面板左栏提供「体检」「贡献病例」两页。写点只有两个，都可关。",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-doctor": "./bin/dsh-doctor.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "diagnostics",
    "health",
    "observability"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QWIET-Crystal/dsh-plugin.git"
  },
  "homepage": "https://github.com/QWIET-Crystal/dsh-plugin#readme",
  "bugs": {
    "url": "https://github.com/QWIET-Crystal/dsh-plugin/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "lib",
    "bin",
    "tools",
    "docs",
    "rescue",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/",
    "prepublishOnly": "node --test test/",
    "cases:lint": "node tools/lint-cases.mjs",
    "cases:index": "node tools/index-cases.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
